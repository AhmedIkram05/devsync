# ── Flask Application Settings ─────────────────────────────────────────────
FLASK_APP=src.app:create_app
FLASK_ENV=development

# ── Local PostgreSQL (Docker) ──────────────────────────────────────────────
# Start with: make db-up
POSTGRES_PASSWORD=your_local_postgres_password
DEVSYNC_POSTGRES_PORT=5432
# Use 'localhost' when running backend on host, 'devsync-postgres' when running in Docker
DATABASE_URL=postgresql://devsync:your_local_postgres_password@localhost:${DEVSYNC_POSTGRES_PORT}/devsync?sslmode=disable

# ── Authentication ─────────────────────────────────────────────────────────
# JWT_SECRET_KEY (JWT signing) is REQUIRED and fail-closes (RuntimeError) if
# missing or set to a known default/placeholder in any non-testing
# environment. SECRET_KEY (Flask sessions) is OPTIONAL: when unset, a
# DISTINCT key is HKDF-derived from JWT_SECRET_KEY (info
# b"devsync-flask-secret-v1") so the backend always boots, but the keys are
# then coupled — set SECRET_KEY for full key separation/rotation.
# Testing fallback applies ONLY when FLASK_ENV==testing or PYTEST_CURRENT_TEST is set.
# Generate each with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Then set:
# SECRET_KEY=
# JWT_SECRET_KEY=
JWT_SECRET_KEY=change-me-in-local-env
# SECRET_KEY=change-me-flask-secret-distinct-from-jwt
JWT_ALGORITHM=HS256
# Token lifetimes — single-sourced in backend/src/config/config.py.
# ACCESS_TOKEN_EXPIRE_MINUTES / REFRESH_TOKEN_EXPIRE_DAYS resolve from these
# env vars; defaults are 15 minutes and 7 days. Blank/unset uses the default.
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# ── Encryption at rest ──────────────────────────────────────────────────────
# FERNET_KEY is REQUIRED in production. It must be a 32-byte urlsafe-b64
# string used to encrypt GitHub OAuth tokens stored in the DB. In
# development and testing it is auto-derived from JWT_SECRET_KEY via HKDF.
# Generate one with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Then set:
# FERNET_KEY=
# Rotation: FERNET_KEYS is a comma-separated list, primary first. Decryption
# tries each key so old rows stay readable after rotation:
# FERNET_KEYS=<new-key>,<old-key>
# Emergency fallback only: ALLOW_DERIVED_FERNET=true permits an HKDF-SHA256
# derived key (info b"devsync-fernet-v1") with a warning log. Prefer an
# explicit FERNET_KEY in production.
# OAuth state uses a separate HKDF-derived key (info b"devsync-oauth-state-v1"),
# never the raw JWT secret. Override only if needed:
# OAUTH_STATE_SECRET=
# ALLOW_DERIVED_FERNET=false
# FERNET_KEY=

# ── GitHub OAuth ───────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/github/callback
FRONTEND_URL=http://localhost:3000

# ── Frontend (Docker) ──────────────────────────────────────────────────────
# Port the frontend is published on (default: 3000)
DEVSYNC_FRONTEND_PORT=3000
