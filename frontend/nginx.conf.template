# Resolve API backend at runtime via environment variable
# NGINX_RESOLVER: 127.0.0.11 (Docker built-in, ECS) or 169.254.20.10
# (GKE node-local DNS, set as an explicit env on the FE Deployment)
resolver ${NGINX_RESOLVER} valid=30s;

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Hide the nginx version in responses and error pages.
    server_tokens off;

    # JSON API only, so bodies are small. File attachments are planned as GCS
    # signed URLs (browser -> bucket directly), so nginx must never carry file
    # payloads: 2m is headroom for JSON plus a long comment, not an upload size.
    client_max_body_size 2m;

    # Slow-client hardening, plus a bounded connect/send to the upstream. Without
    # these, nginx holds a worker connection for the 60s default while a client
    # dribbles a body, and waits indefinitely on a stalled backend.
    client_body_timeout 15s;
    client_header_timeout 15s;
    proxy_connect_timeout 10s;
    proxy_send_timeout 120s;

    # Deliberately no limit_req / limit_conn here: their zones are http-context
    # directives, and this file is rendered into /etc/nginx/conf.d/default.conf
    # (a server block nested inside http), so declaring one would stop nginx from
    # starting. Rate limiting is owned by the backend's Redis-backed limiter
    # (backend/src/api/middlewares/rate_limiter.py, fail-closed), which answers
    # with the API's own 429 envelope; a second limiter here would double-count
    # those requests and break that contract.

    # Gzip compression
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml text/javascript image/svg+xml;
    gzip_min_length 256;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    # HSTS rides the client-facing HTTPS response (the GCE LB terminates
    # TLS and forwards HTTP to nginx); browsers honour it only over HTTPS.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    # Tight CSP: the CRA build loads nothing off-origin (no CDNs, no web
    # fonts); runtime style tags need 'unsafe-inline' under style-src.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' wss: https:; font-src 'self' data:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # API proxy — uses variable so nginx resolves at runtime (supports Docker DNS)
    set $api_upstream "${API_UPSTREAM}";

    location /api/ {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # Socket.IO support (WebSocket)
    location /socket.io/ {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    # Backend health — must proxy, not fall through to the SPA fallback,
    # so curl https://gcp.devsyncapp.me/health hits the API liveness gate.
    location = /health {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # Static asset caching (fingerprinted files)
    # NOTE: a location-level add_header REPLACES inherited server-level
    # headers, so the security headers are repeated here — without that,
    # /static/* responses would drop XFO/nosniff/HSTS/CSP entirely.
    location /static/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' wss: https:; font-src 'self' data:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    }

    # SPA fallback — all non-file routes serve index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}
